{
  "expo": {
    "name": "pawthos",
    "slug": "pawthos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./pawthos/frontend/assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./pawthos/frontend/assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anshesanchez_30.pawthos"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./pawthos/frontend/assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./pawthos/frontend/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0a393441-b0ee-4d19-8302-432f8a6b07b1"
      }
    }
  }
}
